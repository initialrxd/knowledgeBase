# Copy to .env; never commit real credentials.
KB_DATA_DIR=./data
KB_HOST=127.0.0.1
KB_PORT=8765
KB_TOOLS_PORT=8766
# Generated by: knowledge init
KB_API_TOKEN=
KB_ADMIN_TOKEN=

# OpenAI-compatible endpoint roots: include /v1 if your provider requires it.
KB_EMBEDDING_BASE_URL=
KB_EMBEDDING_API_KEY=
KB_EMBEDDING_MODEL=
KB_EMBEDDING_DIMENSIONS=0
KB_EMBEDDING_REVISION=default
KB_EMBEDDING_BATCH_SIZE=8
KB_CHAT_BASE_URL=
KB_CHAT_API_KEY=
KB_CHAT_MODEL=
KB_CHAT_MAX_TOKENS=8192
# Optional separate classifier. Empty values inherit chat settings.
KB_CLASSIFY_BASE_URL=
KB_CLASSIFY_API_KEY=
KB_CLASSIFY_MODEL=

KB_OCR_MODE=auto
# Default: directly read existing text. Structured layout/table Markdown is optional.
KB_PDF_LAYOUT=native
# Embedded illustrations on text pages are preserved, not OCRed by default.
KB_OCR_IMAGE_REGIONS=false
KB_CHUNK_TOKENS=800
KB_CHUNK_OVERLAP=100
# Used to measure chunk size, not to run a local embedding model.
KB_TOKENIZER=cl100k_base
KB_SCAN_INTERVAL=300
KB_FILE_SETTLE_SECONDS=3
KB_API_CONCURRENCY=2
KB_REQUESTS_PER_MINUTE=60
# Query defaults; individual HTTP/MCP calls can override them.
KB_SEARCH_LIMIT=10
KB_SEARCH_MODE=hybrid
KB_SEARCH_CATEGORY=
KB_SEARCH_DOCUMENT_ID=
# Explicit opt-in only. Never enabled silently as a fallback.
KB_DEMO_MODE=false
# Shared with ngrok external URL; leave empty for local-only operation.
KB_PUBLIC_BASE_URL=
